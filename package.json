{
  "name": "slaygent",
  "version": "1.0.0",
  "description": "Slaygent - OpenRouter router recommendation engine + portable prompt/agent skills",
  "type": "module",
  "main": "src/mcp-server.ts",
  "bin": {
    "slaygent": "index.ts",
    "slaygent-setup": "setup.ts",
    "slaygent-mcp": "src/mcp-server.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
    "mcp": "bun run src/mcp-server.ts",
    "setup": "bun run setup.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "files": [
    "index.ts",
    "src/",
    "setup.ts",
    "classifier.ts",
    "model-cache.ts",
    "output.ts",
    "router-recommender.ts",
    "types.ts",
    "skills/",
    ".agents/skills/",
    ".claude/skills/",
    ".claude/commands/",
    ".opencode/commands/",
    "commands/"
  ]
}
